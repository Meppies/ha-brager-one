{
  "config": {
    "step": {
      "user": {
        "title": "Connect to BragerOne",
        "description": "Sign in with the account you use on one.brager.pl or in the BragerOne app.",
        "data": {
          "email": "Email",
          "password": "Password"
        },
        "data_description": {
          "email": "The email address of your BragerOne account.",
          "password": "The password of your BragerOne account. It is stored in Home Assistant and used to renew the session."
        }
      },
      "module": {
        "title": "Choose a module",
        "description": "Your account has more than one module. Choose the one to add; you can add the others afterwards.",
        "data": {
          "devid": "Module"
        },
        "data_description": {
          "devid": "The BragerOne module (controller) to add."
        }
      },
      "reauth_confirm": {
        "title": "Sign in to BragerOne again",
        "description": "BragerOne no longer accepts the stored password for {email}. Enter the current password.",
        "data": {
          "password": "Password"
        },
        "data_description": {
          "password": "The current password of your BragerOne account."
        }
      },
      "reconfigure": {
        "title": "Change the BragerOne account",
        "data": {
          "email": "Email",
          "password": "Password"
        },
        "data_description": {
          "email": "The email address of the BragerOne account that has access to this module.",
          "password": "The password of that account."
        }
      }
    },
    "error": {
      "invalid_auth": "BragerOne rejected the email address or password.",
      "cannot_connect": "Could not reach BragerOne. Try again later.",
      "no_modules": "This account has no modules.",
      "unknown": "Unexpected error. Check the Home Assistant log."
    },
    "abort": {
      "already_configured": "Every module of this account has already been added.",
      "module_missing": "This account has no access to the module of this entry.",
      "reauth_successful": "Signed in again.",
      "reconfigure_successful": "Account updated."
    }
  },
